{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slopedea",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",

  // Static files in ./public are served directly and don't run the Worker.
  // Only /api/* runs the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // Serve on the apex domain; Cloudflare creates the DNS record and certificate.
  // www is redirected to the apex by a Cloudflare redirect rule.
  "routes": [
    { "pattern": "slopedea.com", "custom_domain": true },
    { "pattern": "www.slopedea.com", "custom_domain": true }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "slopedea",
      "database_id": "52bc5a18-e120-417c-a6da-88c5fd7428a5"
    }
  ],

  // Hourly: save a history snapshot and recount tallies.
  "triggers": { "crons": ["0 * * * *"] },

  "vars": {
    // Public Turnstile site key (Cloudflare dashboard → Turnstile). Leave empty to skip the bot check.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF3lDY8nsh4dOaJC",
    // Percentages stay hidden until this many votes are in. Set to "0" to always show.
    "REVEAL_AT": "100",
    // Minutes a person must wait before moving their vote again.
    "SWITCH_COOLDOWN_MIN": "60",
    // Max new voters per network (IP) per day. High enough for shared mobile and office networks.
    "IP_DAILY_CAP": "20"
  }

  // Secrets (set with `npx wrangler secret put NAME`, never commit them):
  //   TURNSTILE_SECRET  Turnstile secret key
  //   SESSION_SECRET    long random string, signs voter cookies
  //   ID_SALT           long random string, hashes IPs for the daily cap
}
